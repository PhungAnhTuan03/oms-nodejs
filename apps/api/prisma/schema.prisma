generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STAFF
}

enum OrderStatus {
  PENDING
  PAID
  CANCELLED
  SHIPPED
}

enum MovementType {
  IN
  OUT
  ADJUST
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  role         Role   @default(STAFF)
}

model Product {
  id        Int       @id @default(autoincrement())
  name      String
  createdAt DateTime  @default(now())
  variants  Variant[]
}

model Variant {
  id        Int         @id @default(autoincrement())
  productId Int
  product   Product     @relation(fields: [productId], references: [id])
  sku       String      @unique
  price     Int
  inventory Inventory?
  items     OrderItem[]
}

model Inventory {
  variantId Int      @id
  variant   Variant  @relation(fields: [variantId], references: [id])
  available Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Order {
  id             Int         @id @default(autoincrement())
  shopifyOrderId String?     @unique
  status         OrderStatus @default(PENDING)
  total          Int
  createdAt      DateTime    @default(now())
  items          OrderItem[]

  @@index([createdAt])
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   Int
  order     Order   @relation(fields: [orderId], references: [id])
  variantId Int
  variant   Variant @relation(fields: [variantId], references: [id])
  quantity  Int
  unitPrice Int
}

model StockMovement {
  id        Int          @id @default(autoincrement())
  variantId Int
  type      MovementType
  quantity  Int
  reason    String
  orderId   Int?
  createdAt DateTime     @default(now())
}

model WebhookEvent {
  id         String   @id
  topic      String
  receivedAt DateTime @default(now())
}
